# Provider order for fallback. Any provider without a key is skipped.
LLM_PROVIDERS=gemini,openai,groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Per-attempt timeout for one LLM call (ms)
LLM_TIMEOUT_MS=20000

# Guardrails
AGENT_MAX_STEPS=8
# Where traces, audit logs and long-term memory are stored
AGENT_STATE_DIR=.agent
